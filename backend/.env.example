# AgentShield Backend Configuration
# Copy this file to .env and fill in values for your environment

# ── Application ───────────────────────────────────────────────────
APP_NAME=AgentShield
APP_VERSION=1.0.0
DEBUG=false

# ── API ──────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/agentshield.db

# ── Network Capture ───────────────────────────────────────────────
# Network interface to capture on (WSL2: eth0, en0; Linux: eth0, ens33)
# Run `ip a` in WSL2 to find available interfaces
CAPTURE_INTERFACE=eth0
PCAP_ROTATION_SECONDS=60
PCAP_OUTPUT_DIR=data/captures

# ── Suricata ─────────────────────────────────────────────────────
# Default EVE JSON log path (override if different in your Suricata config)
SURICATA_EVE_LOG=/var/log/suricata/eve.json
SURICATA_DEDUP_WINDOW_SECONDS=30

# ── Machine Learning ──────────────────────────────────────────────
MODEL_PATH=models/agentshield_rf.pkl
MODEL_METADATA_PATH=models/agentshield_rf_metadata.json
TEST_MODEL_PATH=models/agentshield_rf_test.pkl

# ── Ollama ────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
# Must be a model you have pulled: run `ollama pull llama3.2`
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=30

# ── Risk Thresholds ───────────────────────────────────────────────
RISK_CRITICAL_THRESHOLD=90
RISK_HIGH_THRESHOLD=70
RISK_MEDIUM_THRESHOLD=40
RISK_LOW_THRESHOLD=1

# ── Upload ────────────────────────────────────────────────────────
MAX_PCAP_UPLOAD_MB=50
UPLOAD_DIR=data/uploads

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/agentshield.log
